# Copy to .env and adjust. Defaults below match docker-compose service names.

# --- Postgres (system of record) ---
DATABASE_URL=postgresql+psycopg://sherpa:sherpa@postgres:5432/sherpa
POSTGRES_USER=sherpa
POSTGRES_PASSWORD=sherpa
POSTGRES_DB=sherpa

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=chunks
EMBED_DIM=384

# --- TEI (embedding service) ---
# Must serve a model whose output dim == EMBED_DIM.
TEI_URL=http://tei:80
TEI_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=32

# --- MinIO (raw PDF bytes) ---
MINIO_ENDPOINT=http://minio:9000
# Host-reachable endpoint baked into presigned upload URLs (browser uploads here).
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
MAX_UPLOAD_BYTES=209715200

# --- Ingestion / chunking ---
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=50
OCR_ENABLED=true

# --- Retries / sweep ---
MAX_INGEST_RETRIES=3
ABANDONED_AFTER_S=3600
SWEEP_INTERVAL_S=900
